@page
@model ResultModel
@{
    ViewData["Title"] = "Map Ready";
    Layout = "_Layout";
}

<div class="result-layout">

    @* ── Left panel: stats + actions ── *@
    <aside class="result-panel">
        <h1 class="page-title">Map Ready</h1>

        @if (Model.Stats is { Count: > 0 })
        {
            <span class="section-label">Difficulty Stats</span>
            <div class="stats-table-wrap">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>Difficulty</th>
                            <th>Notes</th>
                            <th>BPM</th>
                            <th>Quality</th>
                            <th>Err</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Stats)
                        {
                            var qc = s.ValidationScore >= 0.7 ? "good" :
                                     s.ValidationScore >= 0.4 ? "ok"   : "bad";
                            <tr>
                                <td><span class="diff-badge diff-@s.Difficulty.ToLower()">@(s.Difficulty == "ExpertPlus" ? "Expert+" : s.Difficulty)</span></td>
                                <td>@s.NoteCount</td>
                                <td>@s.Bpm.ToString("F0")</td>
                                <td><span class="quality-badge @qc">@s.ValidationScore.ToString("P0")</span></td>
                                <td class="@(s.ErrorCount > 0 ? "cell-error" : "")">@s.ErrorCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <hr class="divider" />

        <span class="section-label">Actions</span>
        <div class="action-bar">
            <a href="/api/download/@Model.JobId" class="btn btn-primary" download="beatsaber-map.zip">
                ⬇ Download .zip
            </a>
            <a href="/" class="btn btn-secondary">↺ New Map</a>
        </div>

        @if (Model.ArcViewerUrl is not null)
        {
            <div class="arcviewer-hint">
                <span class="hint">Preview URL:</span>
                <code id="arcUrl" style="font-size:.72rem;word-break:break-all;">@Model.ArcViewerUrl</code>
                <button class="btn-copy" id="copyBtn">Copy</button>
            </div>
        }
    </aside>

    @* ── Right panel: ArcViewer ── *@
    @if (Model.ArcViewerUrl is not null)
    {
        <div class="result-preview">
            <span class="section-label">Live Preview (ArcViewer)</span>
            <div class="arcviewer-wrap">
                <iframe id="arcviewer"
                        src="@Model.ArcViewerUrl"
                        title="Beat Saber Map Preview"
                        allow="autoplay; fullscreen"
                        class="arcviewer-frame"></iframe>
            </div>
            <p class="hint" style="margin-top:.4rem;">
                First load downloads ~80&nbsp;MB of ArcViewer assets — cached locally for subsequent previews.
            </p>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('copyBtn');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var url = document.getElementById('arcUrl').textContent.trim();
        navigator.clipboard.writeText(url).then(function () {
            btn.textContent = '✓ Copied';
            setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
        }).catch(function () {
            btn.textContent = 'Failed';
        });
    });
}());
</script>
}

