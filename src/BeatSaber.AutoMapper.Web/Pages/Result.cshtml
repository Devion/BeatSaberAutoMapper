@page
@model ResultModel
@{
    ViewData["Title"] = "Map Ready";
    Layout = "_Layout";
}

<div class="page-wrap">
    <h1 class="page-title">🎮 Your Map Is Ready!</h1>

    @if (Model.Stats is { Count: > 0 })
    {
        <div class="stats-table-wrap">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>Difficulty</th>
                        <th>Notes</th>
                        <th>BPM</th>
                        <th>Quality</th>
                        <th>Errors</th>
                        <th>Warnings</th>
                        <th>Repairs</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Stats)
                    {
                        var qualityClass = s.ValidationScore >= 0.7 ? "good" :
                                           s.ValidationScore >= 0.4 ? "ok"   : "bad";
                        <tr>
                            <td><span class="diff-badge diff-@s.Difficulty.ToLower()">@(s.Difficulty == "ExpertPlus" ? "Expert+" : s.Difficulty)</span></td>
                            <td>@s.NoteCount</td>
                            <td>@s.Bpm.ToString("F1")</td>
                            <td><span class="quality-badge @qualityClass">@s.ValidationScore.ToString("P0")</span></td>
                            <td class="@(s.ErrorCount > 0 ? "cell-error" : "")">@s.ErrorCount</td>
                            <td class="@(s.WarningCount > 0 ? "cell-warn" : "")">@s.WarningCount</td>
                            <td>@s.RepairCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="action-bar">
        <a href="/api/download/@Model.JobId" class="btn btn-primary" download="beatsaber-map.zip">
            ⬇️ Download Map (.zip)
        </a>
        <a href="/" class="btn btn-secondary">🔄 Generate Another</a>
    </div>

    <div class="preview-section">
        <h2>Preview</h2>
        <div id="mapPreviewContainer" class="preview-wrap"></div>
    </div>
</div>

@section Scripts {
<script src="~/js/mapPreview.js"></script>
<script>
    initMapPreview('mapPreviewContainer', '@Model.JobId');
</script>
}